[
    {
        "label": "Marimo: $ZED_RELATIVE_FILE",
        "command": "uv",
        "args": [
            "run",
            "marimo",
            "edit",
            "$ZED_FILE",
            "--headless",
            "--watch",
            "--port",
            "2718"
        ],
        "cwd": "$ZED_WORKTREE_ROOT",
        "use_new_terminal": true,
        "allow_concurrent_runs": false,
        "reveal": "always"
    },
    {
        "label": "Marimo: Export Jupyter",
        "command": "uv",
        "args": [
            "run",
            "marimo",
            "export",
            "ipynb",
            "$ZED_FILE",
            "-o",
            "$ZED_DIRNAME/__marimo__/$ZED_STEM.ipynb",
            "--include-outputs"
        ],
        "cwd": "$ZED_WORKTREE_ROOT",
        "use_new_terminal": true,
        "allow_concurrent_runs": false,
        "reveal": "always",
        "save": "current"
    }
]
